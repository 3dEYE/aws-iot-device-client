+static int s_aws_websocket_client_connect_with_handshake_failure(
+    const struct aws_websocket_client_connection_options *options) {
+
+    struct aws_secure_tunnel *secure_tunnel = options->user_data;
+    struct aws_secure_tunnel_mock_test_fixture *test_fixture = secure_tunnel->config->user_data;
+    bool should_fail = false;
+    int handshake_response_status = 0;
+
+    aws_mutex_lock(&test_fixture->lock);
+    test_fixture->websocket_connect_attempts++;
+    if (test_fixture->websocket_handshake_failures_remaining > 0) {
+        test_fixture->websocket_handshake_failures_remaining--;
+        handshake_response_status = test_fixture->websocket_handshake_response_status;
+        should_fail = true;
+    }
+    aws_mutex_unlock(&test_fixture->lock);
+
+    if (!should_fail) {
+        return aws_websocket_client_connect_mock_fn(options);
+    }
+
+    struct aws_websocket_on_connection_setup_data websocket_setup = {
+        .error_code = AWS_ERROR_HTTP_WEBSOCKET_UPGRADE_FAILURE,
+        .handshake_response_status = &handshake_response_status,
+    };
+    options->on_connection_setup(&websocket_setup, secure_tunnel);
+
+    return AWS_OP_SUCCESS;
+}
