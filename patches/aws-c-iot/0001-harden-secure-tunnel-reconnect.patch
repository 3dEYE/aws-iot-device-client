+static int s_secure_tunneling_4xx_handshake_stops_without_retry_test_fn(
+    struct aws_allocator *allocator,
+    void *ctx) {
+
+    (void)ctx;
+    struct secure_tunnel_test_options test_options;
+    struct aws_secure_tunnel_mock_test_fixture test_fixture;
+    aws_secure_tunnel_mock_test_init(allocator, &test_options, &test_fixture, AWS_SECURE_TUNNELING_DESTINATION_MODE);
+    struct aws_secure_tunnel *secure_tunnel = test_fixture.secure_tunnel;
+
+    test_fixture.websocket_handshake_failures_remaining = 1;
+    test_fixture.websocket_handshake_response_status = 403;
+    test_fixture.secure_tunnel_vtable.aws_websocket_client_connect_fn =
+        s_aws_websocket_client_connect_with_handshake_failure;
+
+    ASSERT_SUCCESS(aws_secure_tunnel_start(secure_tunnel));
+    s_wait_for_secure_tunnel_stopped(&test_fixture);
+
+    ASSERT_INT_EQUALS((int)test_fixture.websocket_connect_attempts, 1);
+    ASSERT_INT_EQUALS(secure_tunnel->current_state, AWS_STS_STOPPED);
+    ASSERT_INT_EQUALS(secure_tunnel->desired_state, AWS_STS_STOPPED);
+
+    aws_secure_tunnel_mock_test_clean_up(&test_fixture);
+
+    return AWS_OP_SUCCESS;
+}
